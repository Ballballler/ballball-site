# 虚拟环境
.venv/
venv/

# 运行时数据（含口令散列，绝不入库）
data/
*.db
*.db-wal
*.db-shm

# 环境变量与密钥
.env
*.pem
*.key
id_rsa*
id_ed25519*

# 静态导出产物（tools/export_static.py 生成，推 gh-pages 分支用的）
dist/

# 后台上传的图片（和 data/ 同类，属于数据不是代码，用 deploy/backup.sh 备份）
static/uploads/*
# TMDB 海报的本地缓存，由 tools/cache_movie_posters.py 落盘。
# 是抓下来的第三方图片（数据不是代码），跟 uploads 一样不进仓库；
# 但导出静态站时会随 dist/ 一起进 gh-pages，线上照常能显示。
static/posters/*

# 本地备份产物（含数据库与站点截图，不进仓库）
backup/
*.log

# Python
__pycache__/
*.py[cod]
*.egg-info/

# 编辑器 / 系统
.vscode/
.DS_Store
Thumbs.db
