# 服务器是 Linux，shell 脚本与 Python 一律用 LF。
# 否则在 Windows 上提交成 CRLF 后，服务器执行会报
#   /bin/bash^M: bad interpreter: No such file or directory
*.sh      text eol=lf
*.py      text eol=lf
*.service text eol=lf
*.conf    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf

# 二进制资源别让 git 做换行转换，会损坏文件
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.woff2 binary
