# 复制成 .env 后再改：cp .env.example .env
# 真正的环境变量（systemd / docker 注入）优先级高于本文件

# production 会关闭 /api/docs
APP_ENV=dev

# 只在首次启动时生效，之后以后台「改口令」为准
ADMIN_PASSWORD=admin12345

# 会话 Cookie 的签名密钥。留空则自动生成并写回本文件，生成后不要改动
# SECRET_KEY=

# 数据目录（SQLite 与口令文件）
# DATA_DIR=./data
# DATABASE_URL=sqlite:///data/site.db

# 后台会话有效期（秒），默认 43200 = 12 小时
# SESSION_TTL_SECONDS=43200

# 评论限流：同一 IP 在窗口期内最多几条
# COMMENT_RATE_LIMIT=10
# COMMENT_RATE_WINDOW=600

# 先审后发：1 / true / yes / on 开启。
# 开启后访客留言先不公开，要在后台「评论」里点「通过」才显示。
# 评论区完全开放，被刷屏时把这个打开。
# COMMENT_MODERATION=0

# 站点对外地址，用于 sitemap.xml 与分享卡的绝对 URL。
# 部署后必须改成你的域名，否则搜索引擎收录的是 127.0.0.1。
# SITE_URL=https://example.com

# 单张上传图片的上限（字节），默认 8MB
# MAX_UPLOAD_BYTES=8388608

# 单段上传音频的上限（字节），默认 30MB（约 4 分钟 320kbps mp3 的三倍）
# MAX_AUDIO_BYTES=31457280

# ---------------------------- TMDB ----------------------------
# 电影的海报、简介、年份、导演都从 TMDB 抓。
# 关键：只存图片**地址**，不把图片下载到本地，磁盘占用为 0。
#
# 申请：https://www.themoviedb.org/settings/api
#   → 注册账号 → 个人设置 → API → 申请一个 API Key（个人用途免费）
#   → 把那串 32 位十六进制的 "API Key (v3 auth)" 填到这里 → 重启服务
#
# 没填也不影响站点运行，只是后台的「从 TMDB 导入」按钮会提示去申请。
TMDB_API_KEY=
# 元数据语言，默认 zh-CN
# TMDB_LANGUAGE=zh-CN
# 搜索结果缓存时长（秒），默认 600。TMDB 鼓励缓存，能省请求额度
# TMDB_CACHE_TTL=600

# 是否信任 X-Forwarded-For。挂在 nginx 后面设为 1，直接暴露设为 0
# TRUST_PROXY=1
